{
  "package_version": "1.0.0",
  "custom_roles": [
    "code-reviewer",
    "debugger",
    "design-critic",
    "docs-researcher",
    "finding-validator",
    "test-author",
    "test-verifier",
    "scout",
    "mechanic",
    "check-runner"
  ],
  "built_in_roles": [
    "Explore",
    "general-purpose"
  ],
  "model_policy": {
    "default": "inherit",
    "model_override": "optional --model provider-id/model-id",
    "thought_level_override": "optional --thought-level; requires --model",
    "built_in_overrides": "preserve unless --reset-builtin-models is requested"
  },
  "max_concurrency": 4,
  "workflow": [
    "plan",
    "implement",
    "inspect",
    "repair_if_needed",
    "deliver"
  ],
  "inspection_owner": "one-owner-per-question-host-consolidates",
  "automatic_hashes": false,
  "role_selection": "host-planner-selects-bounded-assignments-same-role-multiple-instances",
  "testing_policy": "minimal-targeted-only-for-important-unresolved-behavior",
  "parallel_dispatch": "fill-available-four-subagent-capacity-with-independent-ready-work",
  "cross_checks": "distinct-concrete-functional-questions-only"
}
