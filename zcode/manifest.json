{
  "package_version": "5.0.0",
  "custom_roles": [
    "code-reviewer",
    "debugger",
    "design-critic",
    "docs-researcher",
    "finding-validator",
    "test-author",
    "test-verifier"
  ],
  "built_in_roles": [
    "Explore",
    "general-purpose"
  ],
  "model_policy": {
    "default": "inherit",
    "model_override": "optional --model provider-id/model-id",
    "thought_level_override": "optional --thought-level; requires --model",
    "built_in_overrides": "preserve unless --reset-builtin-models is requested"
  },
  "max_concurrency": 4,
  "workflow": [
    "plan",
    "implement",
    "inspect",
    "repair_if_needed",
    "deliver"
  ],
  "inspection_owner": "host_or_code-reviewer",
  "automatic_hashes": false,
  "role_selection": "host-planner-selects-any-needed-role-within-user-scope",
  "testing_policy": "minimal-targeted-only-for-important-unresolved-behavior"
}
